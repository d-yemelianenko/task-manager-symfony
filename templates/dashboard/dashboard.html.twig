{% extends 'base.html.twig' %}

{% block title %}Dashboard
{% endblock %}

{% block body %}
	<div
		class="container mt-3 mt-md-4">
		{# mniejsze marginesy na mobile #}
		<h1 class="h3 h1-md">Witaj,
			{{ app.user.email }}!
		</h1>
		{# h3 na mobile, h1 na desktop #}
		<p class="text-muted small small-md">Przegląd Twoich zadań</p>

		<div
			class="row g-3">
			{# odstępy między kartami #}
			<div
				class="col-12 col-md-4">
				{# pełna szerokość na mobile #}
				<div class="card border-primary h-100">
					<div
						class="card-body text-center py-3 py-md-4">
						{# większy padding na desktop #}
						<h5 class="card-title fs-6 fs-md-5">Wszystkie zadania</h5>
						{# większy tekst #}
						<h2 class="text-primary display-6 display-md-4">{{ total_tasks }}</h2>
						{# DUŻY tekst #}
					</div>
				</div>
			</div>

			<div class="col-12 col-md-4">
				<div class="card border-success h-100">
					<div class="card-body text-center py-3 py-md-4">
						<h5 class="card-title fs-6 fs-md-5">Ukończone</h5>
						<h2 class="text-success display-6 display-md-4">{{ completed_tasks }}</h2>
					</div>
				</div>
			</div>

			<div class="col-12 col-md-4">
				<div class="card border-warning h-100">
					<div class="card-body text-center py-3 py-md-4">
						<h5 class="card-title fs-6 fs-md-5">Na dziś</h5>
						<h2 class="text-warning display-6 display-md-4">{{ today_tasks }}</h2>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
