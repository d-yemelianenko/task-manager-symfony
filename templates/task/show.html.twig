{% extends 'base.html.twig' %}

{% block title %}Task
{% endblock %}

{% block body %}
	<h1>Task</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Tytuł zadania</th>
				<td>{{ task.title }}</td>
			</tr>
			<tr>
				<th>Opis zadania</th>
				<td>{{ task.description }}</td>
			</tr>
			<tr>
				<th>Status zadania</th>
				<td>
					{% if task.taskStatus %}
						{{ task.taskStatus.name }}
					{% else %}
						<span class="text-muted">Brak statusu</span>
					{% endif %}
				</td>
			</tr>
			<tr>
				<th>Priorytet</th>
				<td>
					{% if task.priority %}
						{% if task.priority.name == 'Krytyczny' %}
							<span class="badge bg-danger">{{ task.priority.name }}</span>
						{% elseif task.priority.name == 'Wysoki' %}
							<span class="badge bg-warning">{{ task.priority.name }}</span>
						{% elseif task.priority.name == 'Średni' %}
							<span class="badge bg-info">{{ task.priority.name }}</span>
						{% else %}
							<span class="badge bg-secondary">{{ task.priority.name }}</span>
						{% endif %}
					{% else %}
						<span class="text-muted">Brak priorytetu</span>
					{% endif %}
				</td>
			</tr>
			<tr>
				<th>Data stworzenia</th>
				<td>{{ task.createdAt ? task.createdAt|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Termin</th>
				<td>{{ task.dueDate ? task.dueDate|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
		</tbody>
	</table>

	<a href="{{ path('app_task_index') }}" class="btn btn-sm btn-outline-primary">Wróć</a>

	<a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-sm btn-outline-secondary">Edytuj</a>

	{{ include('task/_delete_form.html.twig') }}
{% endblock %}
