{% extends 'base.html.twig' %}

{% block title %}Lista Zadań
{% endblock %}

{% block body %}
	<div class="container my-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1>Lista Zadań</h1>
		</div>

		<div class="d-block d-lg-none">
			<div class="row row-cols-1 g-3">
				{% for task in tasks %}
					<div class="col">
						<div class="card h-100 shadow-sm">
							<div class="card-body d-flex flex-column">
								<h5 class="card-title">{{ task.title }}</h5>
								<p class="card-text text-muted small">
									{% if task.description %}
										{% if task.description|length > 100 %}
											{{ task.description|slice(0, 100) }}...
										{% else %}
											{{ task.description }}
										{% endif %}
									{% else %}
										<span class="fst-italic">Brak opisu</span>
									{% endif %}
								</p>

								<div class="mb-2">
									<span class="badge {% if task.taskStatus.name == 'Done' %}bg-success 	{% elseif task.taskStatus.name == 'In Progress' %}bg-warning {% else %}bg-secondary{% endif %}">
										{{ task.taskStatus.name }}
									</span>
									<td>
										{% if task.priority and task.priority.name %}
											<span class="badge bg-info ms-1">{{ task.priority.name }}</span>
										{% else %}
											<span class="badge bg-secondary ms-1">No priority</span>
										{% endif %}
									</td>
								</div>

								<p class="small mb-1">
									<strong>Termin:</strong>
									{{ task.dueDate|date('Y-m-d') }}</p>
								<p class="small mb-1">
									<strong>Utworzone:</strong>
									{{ task.createdAt|date('Y-m-d') }}</p>

								<div class="mt-auto pt-2">
									<div class="btn-group w-100">
										<a href="{{ path('app_task_show', {'id': task.id}) }}" class="btn btn-outline-primary btn-sm">Podgląd</a>
										<a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-outline-secondary btn-sm">Edytuj</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				{% else %}
					<div class="col-12">
						<div class="alert alert-info text-center">
							Brak zadań do wyświetlenia.
						</div>
					</div>
				{% endfor %}
			</div>
		</div>


		<div class="table-responsive">
			<table class="table table-striped">
				<thead class="table-dark">
					<tr>
						<th>Tytuł</th>
						<th>Status</th>
						<th>Priorytet</th>
						<th>Termin</th>
						<th>Utworzone</th>
						<th class="text-end">Akcje</th>
					</tr>
				</thead>
				<tbody>
					{% for task in tasks %}
						<tr>
							<td>
								<strong>{{ task.title }}</strong>
								{# {% if task.description %}
																										<br><small class="text-muted">{{ task.description}}</small>
																									{% endif %} #}
							</td>
							<td>
								<span class="badge	{% if task.taskStatus.name == 'Done' %}bg-success {% elseif task.taskStatus.name == 'In Progress' %}bg-warning {% else %}bg-secondary{% endif %}">
									{{ task.taskStatus.name }}
								</span>
							</td>
							<td>
								{% if task.priority and task.priority.name %}
									<span class="badge bg-info ms-1">{{ task.priority.name }}</span>
								{% else %}
									<span class="badge bg-secondary ms-1">No priority</span>
								{% endif %}
							</td>
							<td>{{ task.dueDate|date('Y-m-d') }}</td>
							<td>{{ task.createdAt|date('Y-m-d') }}</td>
							<td class="text-end">
								<div class="btn-group btn-group-sm">
									<a href="{{ path('app_task_show', {'id': task.id}) }}" class="btn btn-outline-primary">Podgląd</a>
									<a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-outline-secondary">Edytuj</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="text-center text-muted py-4">
								Brak zadań do wyświetlenia.
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

{% endblock %}
