{% extends 'base.html.twig' %}

{% block title %}Task index
{% endblock %}

{% block body %}
	<h1>Task index</h1>
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>Tytuł</th>
					<th>Data stworzenia</th>
					<th>Termin</th>
					<th>Priorytet</th>
					<th>Opcje</th>
				</tr>
			</thead>
			<tbody>
				{% for task in tasks %}
					<tr>
						<td>{{ task.title }}</td>
						<td>{{ task.createdAt|date('d.m.Y H:i') }}</td>
						<td>{{ task.dueDate|date('d.m.Y H:i') }}</td>
						<td>
							{% if task.priority %}
								{% if task.priority.name == 'Krytyczny' %}
									<span class="badge bg-danger">{{ task.priority.name }}</span>
								{% elseif task.priority.name == 'Wysoki' %}
									<span class="badge bg-warning">{{ task.priority.name }}</span>
								{% elseif task.priority.name == 'Średni' %}
									<span class="badge bg-info">{{ task.priority.name }}</span>
								{% else %}
									<span class="badge bg-secondary">{{ task.priority.name }}</span>
								{% endif %}
							{% else %}
								<span class="text-muted">Brak priorytetu</span>
							{% endif %}
						</td>
						<td>
							<a href="{{ path('app_task_show', {'id': task.id}) }}" class="btn btn-sm btn-outline-primary">Pokaż</a>
							<a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-sm btn-outline-secondary">Edytuj</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5">Brak rekordów</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

{% endblock %}
